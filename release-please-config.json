{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "component": "sdk",
      "include-component-in-tag": false,
      "exclude-paths": ["create"]
    },
    "create": {
      "release-type": "node",
      "component": "create"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "zodiac",
      "components": ["sdk", "create"]
    }
  ]
}
