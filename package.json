{
  "name": "@zodiaceco/sdk",
  "version": "1.13.2",
  "author": "Zodiac Labs GmbH",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/gnosisguild/zodiac-sdk",
  "packageManager": "bun@1.3.12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnosisguild/zodiac-sdk.git"
  },
  "type": "module",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./actions": {
      "types": "./dist/actions.d.mts",
      "import": "./dist/actions.mjs"
    },
    "./allow": {
      "types": "./dist/allow/index.d.mts",
      "import": "./dist/allow/index.mjs"
    },
    "./cli/config": {
      "types": "./dist/cli/config.d.mts",
      "import": "./dist/cli/config.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "zodiac": "dist/cli.mjs"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "bun clean",
    "build": "tsdown && cp src/zodiac-os-codegen.d.ts dist/ && printf '/// <reference path=\"./zodiac-os-codegen.d.ts\" />\\n' | cat - dist/index.d.mts > dist/index.d.mts.tmp && mv dist/index.d.mts.tmp dist/index.d.mts",
    "prepublishOnly": "bun run build",
    "check:format": "prettier --list-different .",
    "check:types": "tsc -p tsconfig.json",
    "fix:format": "prettier --write .",
    "test": "bun test",
    "install-local-api-types": "cd ../zodiac-os/public-packages/api-types && pnpm pack-tmp && cd ../../../zodiac-sdk && tar -xzf /tmp/zodiac-os-api-types.tgz --strip-components=1 -C node_modules/@zodiaceco/api-types"
  },
  "dependencies": {
    "@epic-web/invariant": "1.0.0",
    "@zodiaceco/api-types": "^1.7.0",
    "commander": "^14.0.3",
    "defi-kit": "^2.26.12",
    "dotenv": "^17.4.2",
    "open": "^11.0.0",
    "ts-morph": "^27.0.2",
    "zodiac-roles-sdk": "^4.0.0"
  },
  "peerDependencies": {
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "ethers": "^6.13.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "tsdown": "~0.21.9",
    "typescript": "^5.9.2"
  }
}
